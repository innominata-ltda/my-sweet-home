# Copy to .env (git-ignored) and fill locally.
# No real secret or credential should ever be placed in this template file.

# Google Calendar OAuth client IDs (created in Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID_ANDROID=<PLACEHOLDER>
GOOGLE_OAUTH_CLIENT_ID_IOS=<PLACEHOLDER>

# Android release signing keystore configuration (local file path)
ANDROID_KEYSTORE_PATH=<PLACEHOLDER>
ANDROID_KEY_ALIAS=<PLACEHOLDER>
