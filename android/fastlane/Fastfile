# frozen_string_literal: true

# Fastfile for Android automation tasks in My Sweet Home
# Ref: RNF-004, RNF-012

default_platform(:android)

platform :android do
  desc "Validates development environment and required dependencies"
  lane :doctor do
    UI.message("Checking Android, Flutter, and Fastlane environment...")

    project_root = File.expand_path("../..", __dir__)
    package_name = CredentialsManager::AppfileConfig.try_fetch_value(:package_name) || "br.com.innominata.mysweethome"

    UI.message("Configured package: #{package_name}")
    UI.message("Project root directory: #{project_root}")

    # Check Flutter installation
    begin
      sh("flutter --version")
    rescue => e
      UI.user_error!("Flutter was not found in system PATH: #{e.message}")
    end

    # Check Android SDK
    android_sdk = ENV["ANDROID_HOME"] || ENV["ANDROID_SDK_ROOT"]
    if android_sdk && File.directory?(android_sdk)
      UI.message("Android SDK detected: #{android_sdk}")
    else
      UI.important("ANDROID_HOME or ANDROID_SDK_ROOT not set or directory not found.")
    end

    # Check Java / JDK
    begin
      sh("java -version")
    rescue => e
      UI.important("Java could not be verified directly via shell: #{e.message}")
    end

    UI.success("Environment verified successfully for Android!")
  end

  desc "Runs static analysis (flutter analyze and custom_lint)"
  lane :analyze do
    UI.message("Running static analysis...")
    run_make(target: "analyze")
    UI.success("Static analysis completed without errors!")
  end

  desc "Runs unit and widget tests with coverage"
  lane :test do
    UI.message("Running unit and widget tests...")
    run_make(target: "test")
    UI.success("Tests completed successfully!")
  end

  desc "Runs architecture rule tests"
  lane :arch do
    UI.message("Running architecture tests...")
    run_make(target: "arch")
    UI.success("Architecture tests passed!")
  end

  desc "Runs complete pre-build check (analyze, test, arch, coverage)"
  lane :verify do
    UI.message("Running complete pre-build gate (make check)...")
    run_make(target: "check")
    UI.success("All pre-build checks passed successfully!")
  end

  desc "Builds signed Release Android App Bundle (AAB) with release keystore"
  lane :build_bundle do |options|
    UI.message("Building Release Android App Bundle (AAB)...")
    ensure_keystore

    cmd_args = ["build", "appbundle", "--release"]
    cmd_args << "--build-name=#{options[:build_name]}" if options[:build_name]
    cmd_args << "--build-number=#{options[:build_number]}" if options[:build_number]
    if options[:obfuscate]
      symbols_dir = options[:split_debug_info] || "build/app/outputs/symbols"
      cmd_args << "--obfuscate"
      cmd_args << "--split-debug-info=#{symbols_dir}"
    end

    run_flutter(args: cmd_args)

    project_root = File.expand_path("../..", __dir__)
    aab_path = File.join(project_root, "build", "app", "outputs", "bundle", "release", "app-release.aab")

    unless File.exist?(aab_path)
      found_aabs = Dir.glob(File.join(project_root, "build", "app", "outputs", "bundle", "release", "*.aab"))
      aab_path = found_aabs.max_by { |f| File.mtime(f) } if found_aabs.any?
    end

    if aab_path && File.exist?(aab_path)
      size_mb = (File.size(aab_path).to_f / (1024 * 1024)).round(2)
      UI.success("Android App Bundle generated successfully: #{aab_path} (#{size_mb} MB)")
      lane_context[:AAB_OUTPUT_PATH] = aab_path
      lane_context[:GRADLE_AAB_OUTPUT_PATH] = aab_path
      aab_path
    else
      UI.user_error!("Android App Bundle not found in: #{File.join(project_root, 'build', 'app', 'outputs', 'bundle', 'release')}")
    end
  end

  desc "Builds Release split APKs and validates that each APK does not exceed 60 MB (RNF-004)"
  lane :build_apk do |options|
    UI.message("Building Release Split APKs...")
    ensure_keystore

    cmd_args = ["build", "apk", "--release", "--split-per-abi"]
    cmd_args << "--build-name=#{options[:build_name]}" if options[:build_name]
    cmd_args << "--build-number=#{options[:build_number]}" if options[:build_number]
    if options[:obfuscate]
      symbols_dir = options[:split_debug_info] || "build/app/outputs/symbols"
      cmd_args << "--obfuscate"
      cmd_args << "--split-debug-info=#{symbols_dir}"
    end

    run_flutter(args: cmd_args)

    project_root = File.expand_path("../..", __dir__)
    apk_dir = File.join(project_root, "build", "app", "outputs", "flutter-apk")

    apk_files = validate_apk_size(apk_dir: apk_dir, max_size_mb: options[:max_size_mb] || 60)

    lane_context[:APK_OUTPUT_PATH] = apk_files.first
    lane_context[:GRADLE_APK_OUTPUT_PATH] = apk_files.first
    lane_context[:APK_OUTPUT_PATHS] = apk_files
    UI.success("All #{apk_files.length} split APKs built and passed size limits!")
    apk_files
  end

  desc "Validates that each release split APK does not exceed 60 MB (RNF-004)"
  lane :validate_apk_size do |options|
    max_size_mb = (options[:max_size_mb] || 60).to_f
    project_root = File.expand_path("../..", __dir__)
    apk_dir = options[:apk_dir] ? File.expand_path(options[:apk_dir], project_root) : File.join(project_root, "build", "app", "outputs", "flutter-apk")

    apk_files = Dir.glob(File.join(apk_dir, "app-*-release.apk"))
    if apk_files.empty?
      apk_files = Dir.glob(File.join(apk_dir, "*.apk")).reject do |f|
        f.include?("debug") || f.include?("profile") || f.end_with?("app-release.apk")
      end
    end
    if apk_files.empty?
      apk_files = Dir.glob(File.join(apk_dir, "*.apk")).reject do |f|
        f.include?("debug") || f.include?("profile")
      end
    end

    if apk_files.empty?
      UI.user_error!("No release APKs found for validation in: #{apk_dir}")
    end

    apk_files.sort!

    UI.message("Validating APK size limits (RNF-004: max #{max_size_mb} MB)...")

    violating_apks = []
    apk_files.each do |apk_path|
      size_bytes = File.size(apk_path)
      size_mb = (size_bytes.to_f / (1024 * 1024)).round(2)
      apk_name = File.basename(apk_path)

      if size_mb > max_size_mb
        UI.error("#{apk_name}: #{size_mb} MB (exceeds #{max_size_mb} MB limit)")
        violating_apks << { name: apk_name, size: size_mb }
      else
        UI.success("  - #{apk_name}: #{size_mb} MB (within #{max_size_mb} MB limit) [OK]")
      end
    end

    if violating_apks.any?
      details = violating_apks.map { |a| "#{a[:name]} (#{a[:size]} MB)" }.join(", ")
      UI.user_error!("RNF-004 size check failed: APKs exceeded #{max_size_mb} MB limit: #{details}")
    end

    UI.success("RNF-004 size validation passed (#{apk_files.length} APK(s) verified).")
    apk_files
  end

  desc "Resolves next Google Play build_number (max versionCode across tracks + 1)"
  lane :resolve_next_build_number do |options|
    min_build = (options[:min_build_number] || ENV["GITHUB_RUN_NUMBER"] || 1).to_i
    min_build = 1 if min_build < 1

    package_name = options[:package_name] || CredentialsManager::AppfileConfig.try_fetch_value(:package_name) || "br.com.innominata.mysweethome"
    creds = ensure_play_store_credentials(options.merge(allow_missing: true))

    max_code = 0
    if creds
      tracks = %w[internal alpha beta production]
      all_codes = []
      tracks.each do |track|
        begin
          vc_args = { package_name: package_name, track: track }
          vc_args[:json_key] = creds[:json_key] if creds[:json_key]
          vc_args[:json_key_data] = creds[:json_key_data] if creds[:json_key_data]
          codes = google_play_track_version_codes(vc_args)
          all_codes.concat(Array(codes).map(&:to_i))
        rescue => e
          UI.message("Track '#{track}' returned no version codes (#{e.message})")
        end
      end
      max_code = all_codes.max || 0
      UI.message("Highest Google Play versionCode across #{tracks.join(', ')}: #{max_code}")
    else
      UI.important("Play Store credentials unavailable; falling back to min_build_number=#{min_build}.")
    end

    next_build = [max_code + 1, min_build].max
    UI.success("Resolved next build_number: #{next_build}")
    puts "NEXT_BUILD_NUMBER=#{next_build}"

    gh_output = ENV["GITHUB_OUTPUT"]
    if gh_output && !gh_output.strip.empty?
      File.open(gh_output, "a") { |f| f.puts("build_number=#{next_build}") }
    end

    next_build
  end

  desc "Publishes Android App Bundle (AAB) to Internal Testing track on Google Play Console (RNF-012)"
  lane :deploy_internal do |options|
    UI.message("Starting deploy lane for Internal Testing track...")

    if options[:build_number].to_s.strip.empty?
      resolved_build = resolve_next_build_number(options)
      options = options.merge(build_number: resolved_build)
    end

    project_root = File.expand_path("../..", __dir__)
    metadata_path = options[:metadata_path] ?
                      File.expand_path(options[:metadata_path], project_root) :
                      (File.exist?(File.join(project_root, "fastlane", "metadata", "android")) ?
                         File.join(project_root, "fastlane", "metadata", "android") :
                         File.expand_path("metadata/android", __dir__))

    # 1. Locate or build AAB artifact
    aab_path = options[:aab] || lane_context[:AAB_OUTPUT_PATH]
    if aab_path.nil? || !File.exist?(aab_path)
      UI.message("No previous AAB found. Triggering release build (build_bundle)...")
      aab_path = build_bundle(options)
    else
      UI.message("Using existing AAB artifact: #{aab_path}")
    end

    unless aab_path && File.exist?(aab_path)
      UI.user_error!("AAB artifact not found for upload at: #{aab_path}")
    end

    # 2. Display or update release notes (changelogs)
    changelog_dir = File.join(metadata_path, "pt-BR", "changelogs")
    changelog_file = File.join(changelog_dir, "default.txt")
    version_code = options[:version_code] || options[:build_number]
    if version_code
      target_changelog = File.join(changelog_dir, "#{version_code}.txt")
      if File.exist?(target_changelog) || options[:release_notes] || options[:changelog]
        changelog_file = target_changelog
      end
    end

    if options[:release_notes] || options[:changelog]
      custom_notes = (options[:release_notes] || options[:changelog]).to_s.strip
      FileUtils.mkdir_p(changelog_dir)
      File.write(changelog_file, custom_notes, encoding: "utf-8")
      UI.message("Release notes updated via options (#{File.basename(changelog_file)}).")
    end

    if File.exist?(changelog_file)
      notes = File.read(changelog_file, encoding: "utf-8").strip
      UI.message("Release notes loaded (#{File.basename(changelog_file)}):\n#{notes}")
    else
      UI.important("Notice: No release notes found at #{changelog_file}.")
    end

    # 3. Google Play Console credentials
    creds = ensure_play_store_credentials(options)

    # 4. Dry-run mode (simulation)
    if options[:dry_run]
      UI.important("[dry_run] Simulation mode active. Upload to '#{options[:track] || 'internal'}' track simulated successfully.")
      next aab_path
    end

    # 5. Execute upload_to_play_store
    package_name = options[:package_name] || CredentialsManager::AppfileConfig.try_fetch_value(:package_name) || "br.com.innominata.mysweethome"
    track = options[:track] || "internal"
    release_status = options[:release_status] || "completed"

    supply_args = {
      package_name: package_name,
      track: track,
      aab: aab_path,
      metadata_path: metadata_path,
      release_status: release_status,
      skip_upload_apk: true,
      skip_upload_aab: false,
      skip_upload_metadata: options.fetch(:skip_upload_metadata, true),
      skip_upload_changelogs: options.fetch(:skip_upload_changelogs, false),
      skip_upload_images: options.fetch(:skip_upload_images, true),
      skip_upload_screenshots: options.fetch(:skip_upload_screenshots, true),
      validate_only: options.fetch(:validate_only, false),
      check_superseded_tracks: options.fetch(:check_superseded_tracks, true)
    }

    if creds
      supply_args[:json_key] = creds[:json_key] if creds[:json_key]
      supply_args[:json_key_data] = creds[:json_key_data] if creds[:json_key_data]
    end

    UI.message("Uploading AAB (#{File.basename(aab_path)}) to '#{track}' track on Google Play Console...")
    upload_to_play_store(supply_args)
    UI.success("Automatic upload to '#{track}' track completed successfully!")
    aab_path
  end

  desc "Promotes release from internal test track to Production with phased rollout support (RNF-012)"
  lane :promote_to_production do |options|
    UI.message("Starting promotion lane to Production track...")

    project_root = File.expand_path("../..", __dir__)
    metadata_path = options[:metadata_path] ?
                      File.expand_path(options[:metadata_path], project_root) :
                      (File.exist?(File.join(project_root, "fastlane", "metadata", "android")) ?
                         File.join(project_root, "fastlane", "metadata", "android") :
                         File.expand_path("metadata/android", __dir__))

    # 1. Configure source and target track
    track_from = (options[:track_from] || options[:track] || "internal").to_s
    track_to = (options[:track_to] || options[:promote_to] || "production").to_s

    # 2. Configure rollout percentage (0.1 to 1.0)
    raw_rollout = options[:rollout] || ENV["ROLLOUT_PERCENTAGE"] || ENV["ROLLOUT"] || 1.0
    rollout_float = if raw_rollout.to_s.end_with?("%")
                      raw_rollout.to_s.chomp("%").to_f / 100.0
                    else
                      raw_rollout.to_f
                    end
    # Normalize integer values from 1 to 100 (e.g., 10 => 0.1, 50 => 0.5, 100 => 1.0)
    rollout_float = rollout_float / 100.0 if rollout_float > 1.0 && rollout_float <= 100.0

    if rollout_float <= 0.0 || rollout_float > 1.0
      UI.user_error!("Invalid rollout percentage: #{raw_rollout}. Provide a value between 0.01 and 1.0 (e.g., 0.1, 0.25, 0.5, 1.0, or '10%').")
    end

    rollout_pct = (rollout_float * 100.0).round(1)
    release_status = options[:release_status] || (rollout_float < 1.0 ? "inProgress" : "completed")

    UI.message("Source: track '#{track_from}' -> Destination: track '#{track_to}'")
    UI.message("Configured rollout: #{rollout_pct}% (fraction: #{rollout_float}, status: #{release_status})")

    # 3. Google Play Console credentials
    creds = ensure_play_store_credentials(options)

    # 4. Dry-run mode (simulation)
    if options[:dry_run]
      UI.important("[dry_run] Simulation mode active. Promotion from '#{track_from}' to '#{track_to}' (#{rollout_pct}% rollout) simulated successfully.")
      next true
    end

    # 5. Execute promotion via upload_to_play_store
    package_name = options[:package_name] || CredentialsManager::AppfileConfig.try_fetch_value(:package_name) || "br.com.innominata.mysweethome"

    supply_args = {
      package_name: package_name,
      track: track_from,
      track_promote_to: track_to,
      rollout: rollout_float.to_s,
      track_promote_release_status: release_status,
      metadata_path: metadata_path,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: options.fetch(:skip_upload_metadata, true),
      skip_upload_changelogs: options.fetch(:skip_upload_changelogs, false),
      skip_upload_images: options.fetch(:skip_upload_images, true),
      skip_upload_screenshots: options.fetch(:skip_upload_screenshots, true),
      validate_only: options.fetch(:validate_only, false)
    }

    if options[:version_code]
      supply_args[:version_code] = options[:version_code].to_i
      UI.message("Promoting specific version (versionCode: #{supply_args[:version_code]})")
    end

    if creds
      supply_args[:json_key] = creds[:json_key] if creds[:json_key]
      supply_args[:json_key_data] = creds[:json_key_data] if creds[:json_key_data]
    end

    UI.message("Promoting release from '#{track_from}' to '#{track_to}' on Google Play Console...")
    upload_to_play_store(supply_args)
    UI.success("Promotion to '#{track_to}' track completed successfully with #{rollout_pct}% rollout!")
    true
  end

  # Internal helper to ensure release keystore is configured
  private_lane :ensure_keystore do |options|
    require "pathname"
    require "fileutils"

    key_props = File.expand_path("../key.properties", __dir__)
    if File.exist?(key_props)
      props = {}
      File.foreach(key_props) do |line|
        line = line.strip
        next if line.empty? || line.start_with?("#")
        k, v = line.split("=", 2)
        props[k.strip] = v.strip if k && v
      end

      store_file = props["storeFile"]
      if store_file
        store_path = Pathname.new(store_file).absolute? ? store_file : File.expand_path("../app/#{store_file}", __dir__)
        if File.exist?(store_path)
          UI.message("Release keystore configured via key.properties (#{store_path}).")
        else
          UI.important("Keystore specified in key.properties not found at: #{store_path}")
        end
      else
        UI.message("Release keystore configured via key.properties.")
      end
    elsif ENV["KEYSTORE_PASSWORD"] && !ENV["KEYSTORE_PASSWORD"].to_s.strip.empty?
      UI.message("Generating temporary key.properties from environment variables...")
      keystore_file = ENV["KEYSTORE_PATH"] || "upload-keystore.jks"
      keystore_abs = if Pathname.new(keystore_file).absolute?
                       File.expand_path(keystore_file)
                     else
                       File.expand_path("../app/#{keystore_file}", __dir__)
                     end

      if ENV["ANDROID_KEYSTORE_BASE64"] && !File.exist?(keystore_abs)
        require "base64"
        FileUtils.mkdir_p(File.dirname(keystore_abs))
        File.binwrite(keystore_abs, Base64.decode64(ENV["ANDROID_KEYSTORE_BASE64"]))
        UI.message("Keystore decoded from ANDROID_KEYSTORE_BASE64.")
      end

      store_file_for_props = Pathname.new(keystore_file).absolute? ? keystore_abs.tr("\\", "/") : keystore_file.tr("\\", "/")

      key_alias = ENV["KEY_ALIAS"].to_s.strip
      if key_alias.empty? && File.exist?(keystore_abs)
        begin
          store_pass = ENV["KEYSTORE_PASSWORD"].to_s
          keytool_cmd = Gem.win_platform? ? "keytool.exe" : "keytool"
          keytool_out = `#{keytool_cmd} -list -keystore "#{keystore_abs}" -storepass "#{store_pass}" 2>&1`
          entries = keytool_out.scan(/^([^,\n\r]+),\s*[^\n\r]+,\s*PrivateKeyEntry/i).flatten.map(&:strip)
          if entries.any?
            key_alias = entries.first
            UI.message("Alias detected automatically in keystore via keytool: #{key_alias}")
          else
            first_entry = keytool_out.lines.map(&:strip).find { |l| l.include?(",") && !l.start_with?("Keystore") && !l.start_with?("Your keystore") }
            if first_entry
              candidate = first_entry.split(",").first.to_s.strip
              key_alias = candidate unless candidate.empty?
              UI.message("Alias detected in keystore: #{key_alias}") if key_alias
            end
          end
        rescue => e
          UI.important("Could not inspect keystore alias via keytool: #{e.message}")
        end
        if key_alias.empty?
          key_alias = "upload"
          UI.important("KEY_ALIAS not provided and not detected via keytool; using fallback: 'upload'")
        end
      end

      File.open(key_props, "w") do |f|
        f.puts "storePassword=#{ENV['KEYSTORE_PASSWORD']}"
        f.puts "keyPassword=#{ENV['KEY_PASSWORD'] || ENV['KEYSTORE_PASSWORD']}"
        f.puts "keyAlias=#{key_alias}"
        f.puts "storeFile=#{store_file_for_props}"
      end
      UI.success("key.properties file generated successfully (alias: #{key_alias})!")
    elsif options && options[:allow_missing]
      UI.important("Notice: 'android/key.properties' not found and signing variables not set.")
      UI.important("   Release compilation may fail or produce an unsigned artifact.")
    else
      UI.user_error!("Release keystore not configured! Create 'android/key.properties' or set KEYSTORE_PASSWORD and KEY_ALIAS environment variables (and ANDROID_KEYSTORE_BASE64 if needed).")
    end
  end

  # Internal helper to ensure or extract Google Play Console credentials
  private_lane :ensure_play_store_credentials do |options|
    require "base64"
    require "fileutils"

    if options && options[:json_key] && File.exist?(options[:json_key])
      UI.message("Play Store credential provided via options[:json_key]: #{options[:json_key]}")
      next { json_key: File.expand_path(options[:json_key]) }
    end

    if options && options[:json_key_data]
      UI.message("Play Store credential provided via options[:json_key_data].")
      next { json_key_data: options[:json_key_data] }
    end

    if ENV["PLAY_STORE_JSON_KEY_FILE"] && File.exist?(ENV["PLAY_STORE_JSON_KEY_FILE"])
      UI.message("Play Store credential obtained via PLAY_STORE_JSON_KEY_FILE: #{ENV['PLAY_STORE_JSON_KEY_FILE']}")
      next { json_key: File.expand_path(ENV["PLAY_STORE_JSON_KEY_FILE"]) }
    end

    if ENV["PLAY_STORE_JSON_KEY"] && !ENV["PLAY_STORE_JSON_KEY"].strip.empty?
      raw = ENV["PLAY_STORE_JSON_KEY"].strip
      if raw.start_with?("{")
        UI.message("Play Store credential detected as raw JSON in PLAY_STORE_JSON_KEY.")
        next { json_key_data: raw }
      elsif !raw.include?("\n") && !raw.include?('"') && File.exist?(raw)
        UI.message("Play Store credential provided as file path in PLAY_STORE_JSON_KEY: #{raw}")
        next { json_key: File.expand_path(raw) }
      else
        begin
          decoded = Base64.decode64(raw).strip
          if decoded.start_with?("{")
            UI.message("Play Store credential decoded from base64 in PLAY_STORE_JSON_KEY.")
            next { json_key_data: decoded }
          end
        rescue => e
          UI.important("Failed to decode PLAY_STORE_JSON_KEY as base64: #{e.message}")
        end
        next { json_key_data: raw }
      end
    end

    default_file = File.expand_path("play-store-credentials.json", __dir__)
    if File.exist?(default_file)
      UI.message("Play Store credential found at #{default_file}")
      next { json_key: default_file }
    end

    if options && (options[:allow_missing] || options[:dry_run])
      UI.important("Google Play Console credentials not found.")
      next nil
    end

    UI.user_error!("Google Play Console credentials not configured! Provide PLAY_STORE_JSON_KEY (raw JSON or base64), PLAY_STORE_JSON_KEY_FILE, or place 'play-store-credentials.json' in android/fastlane/.")
  end

  # Internal helper to execute Flutter commands in repository root
  private_lane :run_flutter do |options|
    args = options[:args]
    args_str = args.is_a?(Array) ? args.join(" ") : args.to_s
    project_root = File.expand_path("../..", __dir__)
    flutter_bin = Gem.win_platform? ? "flutter.bat" : "flutter"
    cmd = "#{flutter_bin} #{args_str}"
    UI.message("Executing: #{cmd}")
    Dir.chdir(project_root) do
      sh(cmd)
    end
  end

  # Internal helper to execute Makefile targets in repository root
  private_lane :run_make do |options|
    target = options[:target]
    project_root = File.expand_path("../..", __dir__)
    is_windows = Gem.win_platform?
    make_args = is_windows ? "FLUTTER=flutter.bat DART=dart.bat #{target}" : target
    Dir.chdir(project_root) do
      sh("make #{make_args}")
    end
  end
end
